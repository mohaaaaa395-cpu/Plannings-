# ===== CEDIF Saint-Antoine - Planning App =====
# Copy this file to .env for local development.
# On Railway these are provided/set in the service Variables tab.

# PostgreSQL connection string.
# Railway provides this automatically when you add a PostgreSQL plugin
# and reference it (e.g. ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cedif

# Secret used to sign session JWTs. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string

# Default administrator account created on first boot (seed).
# You can change the password later from the app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cedif2026

# Server port (Railway sets PORT automatically).
PORT=8080

# Node environment
NODE_ENV=production
